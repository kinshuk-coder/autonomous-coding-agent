GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Conservative settings for a 15 RPM / 8k TPM account limit.
GROQ_RPM=12
GROQ_TPM=8000
GROQ_TPM_SAFETY_RATIO=0.70
GROQ_PLAN_MAX_TOKENS=500
GROQ_PATCH_MAX_TOKENS=1000
GROQ_MAX_RETRIES=4
GROQ_CONTEXT_CHARS=3500
# Keep planning cheap; use controlled native reasoning for code patches.
GROQ_PLAN_REASONING_EFFORT=none
GROQ_PATCH_REASONING_EFFORT=low
