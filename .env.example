MISTRAL_API_KEY=your_mistral_api_key_here
# devstral-2512 was retired; use Mistral's supported replacement.
MISTRAL_MODEL=mistral-medium-3-5
# At least 1.205 seconds between model calls.
MISTRAL_RPS=0.83
MISTRAL_MAX_RETRIES=4
# Conservative rolling-window token budget for your Mistral plan.
MISTRAL_TPM=25000
MISTRAL_OUTPUT_TOKEN_RESERVE=2000
# Maximum total repository context per model call.
MISTRAL_CONTEXT_CHARS=8000
